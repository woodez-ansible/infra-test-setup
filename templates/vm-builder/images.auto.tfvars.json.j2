{#- {{ ansible_managed }} — JSON has no comments, so this note is a Jinja comment -#}
{%- set images = {} -%}
{%- for release, img in ubuntu_images.items() -%}
{%-   set _ = images.update({release: {
        'build': img.build,
        'path': tf_cache_dir ~ '/ubuntu-' ~ release ~ '-' ~ img.build ~ '.img'}}) -%}
{%- endfor -%}
{#- Completed Windows golden images (playbooks/tasks/windows-builds.yml) -#}
{%- for w in windows_builds | default([]) -%}
{%-   set _ = images.update({w.key: {'build': w.build, 'path': w.path}}) -%}
{%- endfor -%}
{{ {'libvirt_uri': libvirt_uri, 'pool': libvirt_pool, 'images': images} | to_nice_json }}
