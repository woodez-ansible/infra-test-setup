# {{ ansible_managed }}
# Everything an onboarded app gets: its own namespace, limits, and a deploy identity
# that can only act inside that namespace.
apiVersion: v1
kind: Namespace
metadata:
  name: {{ app }}
  labels:
    apexkube.xyz/app: {{ app }}
    apexkube.xyz/repo: {{ repo | replace('/', '.') }}
    pod-security.kubernetes.io/enforce: baseline
    pod-security.kubernetes.io/warn: restricted
---
apiVersion: v1
kind: ResourceQuota
metadata: { name: app-quota, namespace: {{ app }} }
spec:
  hard:
    requests.cpu: "{{ app_quota.requests_cpu }}"
    requests.memory: {{ app_quota.requests_memory }}
    limits.cpu: "{{ app_quota.limits_cpu }}"
    limits.memory: {{ app_quota.limits_memory }}
    pods: "{{ app_quota.pods }}"
    services.loadbalancers: "0"     # use the shared Gateway; LB IPs are scarce
    services.nodeports: "0"
---
apiVersion: v1
kind: LimitRange
metadata: { name: app-defaults, namespace: {{ app }} }
spec:
  limits:
    - type: Container
      default:        { cpu: {{ app_default_limits.cpu }}, memory: {{ app_default_limits.memory }} }
      defaultRequest: { cpu: {{ app_default_requests.cpu }}, memory: {{ app_default_requests.memory }} }
---
apiVersion: v1
kind: ServiceAccount
metadata: { name: deployer, namespace: {{ app }} }
automountServiceAccountToken: false
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata: { name: deployer-edit, namespace: {{ app }} }
subjects:
  - kind: ServiceAccount
    name: deployer
    namespace: {{ app }}
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: edit                       # includes HTTPRoutes via the gateway-routes-edit aggregation
---
apiVersion: v1
kind: Secret
metadata:
  name: deployer-token
  namespace: {{ app }}
  annotations:
    kubernetes.io/service-account.name: deployer
type: kubernetes.io/service-account-token
